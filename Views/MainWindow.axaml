<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WestcoastEducationDesktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="WestcoastEducationDesktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="WestcoastEducationDesktop">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="180,*">

        <StackPanel Grid.Column="0" Spacing="10" Margin="10">
            <TextBlock Text="Westcoast Education" FontSize="18" />

            <Button Content="Kurser" />
            <Button Content="Studenter" />
            <Button Content="Lärare" />
        </StackPanel>

        <TextBlock Grid.Column="1"
                    Text="Välkommen till Westcoast Education!"
                    Margin="20" />

    </Grid>

</Window>
