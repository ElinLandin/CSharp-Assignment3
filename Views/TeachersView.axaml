<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WestcoastEducationDesktop.ViewModels"
             x:DataType="vm:TeachersViewModel"
             x:Class="WestcoastEducationDesktop.Views.TeachersView">

  <StackPanel Spacing="10">
      <TextBlock Text="Lärare" FontSize="24" Foreground="{DynamicResource ForegroundColor}" Background="{DynamicResource BackgroundColor}" />

      <TextBlock Text="Förnamn" />
      <TextBox Text="{Binding NewFirstName}" />

      <TextBlock Text="Efternamn" />
      <TextBox Text="{Binding NewLastName}" />

      <TextBlock Text="Personnummer" />
      <TextBox Text="{Binding NewPersonalIdNumber}" />

      <TextBlock Text="Kompetensområde" />
      <TextBox Text="{Binding NewAreaOfExpertise}" />

      <Button Content="Lägg till lärare"
              Command="{Binding AddTeacherCommand}"
              Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource ForegroundColor}" />

      <ItemsControl ItemsSource="{Binding Teachers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="15">

              <TextBlock Text="{Binding FirstName}" />
              <TextBlock Text="{Binding LastName}" />
              <TextBlock Text="{Binding PersonalIdNumber}" />

              <TextBox Width="160" Text="{Binding AreaOfExpertise, Mode=TwoWay}" />
              <Button Content="Spara kompetens" Command="{Binding $parent[UserControl].((vm:TeachersViewModel)DataContext).UpdateTeacherCommand}"
                      CommandParameter="{Binding}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource ForegroundColor}" />

            </StackPanel>
          </DataTemplate>
      </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
</UserControl>
